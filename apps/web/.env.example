# Copy to .env.local (git-ignored) and fill in.
#
# Local stack: `cd apps/backend && pnpm db:start` prints both of these. The
# local keys are identical on every machine and are not secret.
# Hosted: Supabase dashboard → Project Settings → API keys.
#
# The publishable key (sb_publishable_…) is the current one; the legacy `anon`
# JWT still works but is on its way out. Either way it is public by design — it
# ships in the browser bundle and RLS is what keeps it harmless. The secret /
# service-role key must never appear here.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Maps Embed API key. Optional: without it the map falls back to the
# keyless embed, which cannot label the pin. Free and unmetered — Maps Embed API
# is not billed per load, but the Cloud project still needs billing enabled.
# Create at console.cloud.google.com → APIs & Services → Credentials, enable
# "Maps Embed API", and restrict the key by HTTP referrer to the site's domain.
VITE_GOOGLE_MAPS_EMBED_KEY=

# PostHog browser analytics. Both values are public and bundled into the client.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=<ph_project_token>
VITE_PUBLIC_POSTHOG_HOST=<ph_client_api_host>
