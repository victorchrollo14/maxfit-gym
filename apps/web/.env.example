# Copy to .env.local (git-ignored) and fill in.
#
# Local stack: `cd apps/backend && pnpm db:start` prints both of these. The
# local keys are identical on every machine and are not secret.
# Hosted: Supabase dashboard → Project Settings → API keys.
#
# The publishable key (sb_publishable_…) is the current one; the legacy `anon`
# JWT still works but is on its way out. Either way it is public by design — it
# ships in the browser bundle and RLS is what keeps it harmless. The secret /
# service-role key must never appear here.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Server only ──────────────────────────────────────────────────────────────
# No VITE_ prefix, so these never reach the browser. Read by the API routes in
# src/routes/api/. Locally they go in .env.local like the rest; in production,
# in the container's env (docker run --env-file), never baked into the image.

# Secret key (sb_secret_…), for the CRM's server functions: they create members
# and write memberships and payments past RLS, after checking the admin claim.
# Hosted: Project Settings → API keys. Local: `supabase status` prints it.
SUPABASE_SECRET_KEY=

# From Authentication → Hooks → Send SMS in the Supabase dashboard (v1,whsec_…)
SEND_SMS_HOOK_SECRETS=

WHATSAPP_ACCESS_TOKEN=
